APP_ENV=development
PORT=8080

# MySQL DSN, see https://github.com/go-sql-driver/mysql#dsn-data-source-name
DATABASE_DSN=root:password@tcp(127.0.0.1:3306)/online_grocery?charset=utf8mb4&parseTime=True&loc=Local

JWT_SECRET=change-me-in-production
JWT_EXPIRY_HOURS=72

FRONTEND_BASE_URL=http://localhost:3000

# Used to send verification / password reset emails
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@onlinegrocery.local

# Shipping cost + geolocation providers (see project References)
RAJAONGKIR_API_KEY=
OPENCAGE_API_KEY=

UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=1
