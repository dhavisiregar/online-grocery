APP_ENV=development
PORT=8080

# MySQL DSN, see https://github.com/go-sql-driver/mysql#dsn-data-source-name
DATABASE_DSN=root:password@tcp(127.0.0.1:3306)/online_grocery?charset=utf8mb4&parseTime=True&loc=Local

# Only needed for managed MySQL providers that sign their server cert with
# a private CA (e.g. Aiven) instead of a publicly-trusted one. Paste the
# full contents of the downloaded ca.pem here (multi-line is fine), and
# add `&tls=custom` to DATABASE_DSN above to actually use it. Leave both
# blank for local/self-hosted MySQL with no TLS.
DATABASE_CA_CERT=

JWT_SECRET=change-me-in-production
JWT_EXPIRY_HOURS=72

FRONTEND_BASE_URL=http://localhost:3000

# Used to send verification / password reset emails
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@onlinegrocery.local

# Shipping cost + geolocation providers (see project References)
RAJAONGKIR_API_KEY=
OPENCAGE_API_KEY=

# Payment gateway (Midtrans Snap) — required; it's the only payment
# method, so order creation fails without a server key configured.
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_ENV=sandbox

UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=1
