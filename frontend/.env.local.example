NEXT_PUBLIC_API_URL=http://localhost:8080

# Midtrans Snap client key — safe to expose client-side (that's its
# purpose), used only to load the Snap.js checkout popup script. Leave
# blank to hide the "Bayar Online" payment option.
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=
NEXT_PUBLIC_MIDTRANS_IS_PRODUCTION=false
